{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klausum-otp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Placement hint tested (azure:westeurope, next to D1): server time fell to ~30 ms but
  // Ghana round trips got SLOWER (+30 ms on send) because of the extra edge→Azure hop.
  // With every endpoint at one D1 round trip, running at the Accra edge is faster.
  "routes": [
    { "pattern": "otp.klausum.study", "custom_domain": true },
    { "pattern": "status.klausum.study", "custom_domain": true }
  ],
  // 3 of the 5 free Cron Triggers: cleanup 03:17 UTC · self-check every 15 min · summary 08:00 (Ghana = UTC)
  "triggers": { "crons": ["17 3 * * *", "*/15 * * * *", "0 8 * * *"] },
  "vars": {
    "EMAIL_FROM": "Klausum <otp@mail.klausum.study>",
    "AHASEND_ACCOUNT_ID": "6fbd608c-7b79-4076-aa41-7022602b5f90"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klausum-otp",
      "database_id": "5d79963c-8ded-4f50-b9b2-913e353aaa6c",
      "migrations_dir": "migrations"
    }
  ],
  // Staging: its own Worker, database and secrets, at otp-staging.klausum.study.
  // Deploy with `npx wrangler deploy --env staging` (CI does this for every pull request).
  // No cron triggers here: production already uses 3 of the account's 5 free ones.
  "env": {
    "staging": {
      "name": "klausum-otp-staging",
      "routes": [{ "pattern": "otp-staging.klausum.study", "custom_domain": true }],
      "triggers": { "crons": [] },
      "vars": {
        "EMAIL_FROM": "Klausum Staging <otp@mail.klausum.study>",
        "AHASEND_ACCOUNT_ID": "6fbd608c-7b79-4076-aa41-7022602b5f90"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "klausum-otp-staging",
          "database_id": "857d3414-dcbc-4013-af11-34918436d088",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
