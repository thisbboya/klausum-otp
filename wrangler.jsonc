{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klausum-otp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "otp.klausum.study", "custom_domain": true }],
  // Daily cleanup at 03:17 UTC (uses 1 of the 5 free Cron Triggers)
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "EMAIL_FROM": "Klausum <otp@mail.klausum.study>" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "klausum-otp",
      "database_id": "5d79963c-8ded-4f50-b9b2-913e353aaa6c",
      "migrations_dir": "migrations"
    }
  ]
}
