{
  "name": "@klausum/otp",
  "version": "0.1.0",
  "description": "Tiny zero-dependency client for the Klausum OTP service (email/SMS one-time codes).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
